# ORBITIQ environment — copy to .env
SIMULATION_SEED=42
DATABASE_URL=postgresql://orbitiq:orbitiq@postgres:5432/orbitiq
REDIS_URL=redis://redis:6379/0
OPENCELLID_API_KEY=
# Live-data controls (all optional; snapshots are the offline fallback):
# ORBITIQ_DATA=snapshot   # force deterministic snapshots, no network
# OPENCELLID_REFRESH=1    # re-fetch live towers (costs API credits), refresh cache
# CELESTRAK_REFRESH=1     # re-fetch live TLEs
# OPENCELLID_CSV=/path/to/opencellid.csv   # explicit full dump
# CELESTRAK_TLE=/path/to/live.tle          # explicit TLE file
CELESTRAK_URL=https://celestrak.org/NORAD/elements/gp.php?GROUP=stations&FORMAT=tle
NOAA_SW_URL=https://services.swpc.noaa.gov/json/planetary_k_index_1m.json
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
DEMO_MODE=true
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
API_KEY=
